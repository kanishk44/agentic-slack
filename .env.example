# Server
PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/agentic-slack
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CLIENT_ORIGIN=http://localhost:5173
